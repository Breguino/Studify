{
  "name": "studify-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Demo guidata di Studify: una pagina a parte (Artifact) con dati d'esempio, separata dall'app.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/font.mjs && vite",
    "build": "node scripts/font.mjs && parcel build index.html --dist-dir dist --no-source-maps && html-inline dist/index.html > dist/bundle.html && node scripts/page.mjs",
    "check": "node scripts/font.mjs && tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@parcel/config-default": "^2.16.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "html-inline": "^1.2.0",
    "parcel": "^2.16.4",
    "parcel-resolver-tspaths": "^0.0.9",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
